{% extends 'base.html.twig' %}

{% block title %}Articles expirant bientôt - 1ventaire{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">1ventaire</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_inventory_index') }}">Mes inventaires</a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                        {{ app.user.firstName }}
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Mon profil</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Articles expirant bientôt</h1>
    </div>

    {% if items|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Inventaire</th>
                        <th>Catégorie</th>
                        <th>Emplacement</th>
                        <th>Date d'expiration</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        <tr>
                            <td>
                                {{ item.name }}
                            </td>
                            <td><a href="{{ path('app_inventory_show', {'id': item.inventory.id}) }}">{{ item.inventory.name }}</a></td>
                            <td>{{ item.category ? item.category.name : 'N/A' }}</td>
                            <td>{{ item.location ? item.location.name : 'N/A' }}</td>
                            <td>
                                {% if item.expiryDate %}
                                    {% set daysLeft = ((item.expiryDate|date('U') - "now"|date('U')) / 86400)|round %}
                                    {% if daysLeft < 0 %}
                                        <span class="badge bg-danger">Expiré depuis {{ daysLeft|abs }} jour(s)</span>
                                    {% elseif daysLeft <= 7 %}
                                        <span class="badge bg-warning text-dark">Expire dans {{ daysLeft }} jour(s)</span>
                                    {% else %}
                                        {{ item.expiryDate|date('d/m/Y') }}
                                    {% endif %}
                                {% else %}
                                    N/A
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_item_show', {'id': item.id}) }}" class="btn btn-sm btn-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                                {% if is_granted('edit', item) %}
                                    <a href="{{ path('app_item_edit', {'id': item.id}) }}" class="btn btn-sm btn-secondary ms-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                {% else %}
                                    <button class="btn btn-sm btn-secondary ms-1 disabled" 
                                            data-bs-toggle="tooltip" 
                                            data-bs-placement="top" 
                                            title="Vous n'avez pas les droits nécessaires pour modifier cet article">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-success">
            <p class="mb-0">Aucun article n'arrive bientôt à expiration. Tout va bien !</p>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialise les tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
{% endblock %}