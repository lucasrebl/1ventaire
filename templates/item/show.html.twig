{% extends 'base.html.twig' %}

{% block title %}{{ item.name }} - 1ventaire{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">1ventaire</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_inventory_index') }}">Mes inventaires</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_item_expiring_soon') }}">Articles expirant bientôt</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                        {{ app.user.firstName }}
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Mon profil</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_inventory_index') }}">Mes inventaires</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_inventory_show', {'id': item.inventory.id}) }}">{{ item.inventory.name }}</a></li>
            <li class="breadcrumb-item active">{{ item.name }}</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h2>{{ item.name }}</h2>
                </div>
                <div class="card-body">
                    <div class="row">
                        {% if item.image %}
                            <div class="col-md-4 mb-3">
                                <img src="{{ asset('uploads/items/' ~ item.image) }}" alt="{{ item.name }}" class="img-fluid rounded">
                            </div>
                        {% endif %}
                        <div class="col">
                            {% if item.description %}
                                <p>{{ item.description }}</p>
                            {% else %}
                                <p class="text-muted">Aucune description</p>
                            {% endif %}
                            
                            <div class="mt-3">
                                <h5>Détails</h5>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">
                                        <strong>Inventaire:</strong> {{ item.inventory.name }}
                                    </li>
                                    <li class="list-group-item">
                                        <strong>Catégorie:</strong> {{ item.category ? item.category.name : 'Non catégorisé' }}
                                    </li>
                                    <li class="list-group-item">
                                        <strong>Emplacement:</strong> {{ item.location ? item.location.name : 'Non spécifié' }}
                                    </li>
                                    <li class="list-group-item">
                                        <strong>Quantité:</strong> {{ item.quantity ?: 1 }}
                                    </li>
                                    {% if item.barcode %}
                                    <li class="list-group-item">
                                        <strong>Code-barres:</strong> {{ item.barcode }}
                                    </li>
                                    {% endif %}
                                    <li class="list-group-item">
                                        <strong>Date d'expiration:</strong> 
                                        {% if item.expiryDate %}
                                            {% set daysLeft = ((item.expiryDate|date('U') - "now"|date('U')) / 86400)|round %}
                                            {% if daysLeft < 0 %}
                                                <span class="badge bg-danger">Expiré depuis {{ daysLeft|abs }} jour(s)</span>
                                            {% elseif daysLeft <= 7 %}
                                                <span class="badge bg-warning text-dark">Expire dans {{ daysLeft }} jour(s)</span>
                                            {% else %}
                                                {{ item.expiryDate|date('d/m/Y') }}
                                            {% endif %}
                                        {% else %}
                                            Non applicable
                                        {% endif %}
                                    </li>
                                    <li class="list-group-item">
                                        <strong>Ajouté le:</strong> {{ item.createdAt|date('d/m/Y') }}
                                    </li>
                                    {% if item.updatedAt %}
                                    <li class="list-group-item">
                                        <strong>Modifié le:</strong> {{ item.updatedAt|date('d/m/Y') }}
                                    </li>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_inventory_show', {'id': item.inventory.id}) }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Retour à l'inventaire
                        </a>
                        <div>
                            <a href="{{ path('app_item_edit', {'id': item.id}) }}" class="btn btn-primary">
                                <i class="bi bi-pencil me-1"></i>Modifier
                            </a>
                            <form method="post" action="{{ path('app_item_delete', {'id': item.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet article ?');" style="display: inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                <button class="btn btn-danger ms-1">
                                    <i class="bi bi-trash me-1"></i>Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}