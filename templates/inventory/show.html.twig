{% extends 'base.html.twig' %}

{% block title %}{{ inventory.name }} - 1ventaire{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">1ventaire</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_inventory_index') }}">Mes inventaires</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_category_index') }}">Catégories</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_location_index') }}">Emplacements</a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                        {{ app.user.firstName }}
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('app_user_profile') }}">Mon profil</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}
    
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_inventory_index') }}">Mes inventaires</a></li>
            <li class="breadcrumb-item active">{{ inventory.name }}</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>{{ inventory.name }}</h1>
        <div>
            {% if can_edit is defined and can_edit %}
                <a href="{{ path('app_item_new', {'inventory_id': inventory.id}) }}" class="btn btn-success">
                    <i class="bi bi-plus-circle me-2"></i>Ajouter un article
                </a>
            {% else %}
                <button type="button" class="btn btn-success disabled" 
                        data-bs-toggle="tooltip" 
                        data-bs-placement="top" 
                        title="Vous n'avez pas les droits nécessaires pour ajouter des articles">
                    <i class="bi bi-plus-circle me-2"></i>Ajouter un article
                </button>
            {% endif %}
            
            {% if is_owner is defined and is_owner %}
                <a href="{{ path('app_inventory_share', {'id': inventory.id}) }}" class="btn btn-info ms-2">
                    <i class="bi bi-share me-2"></i>Partager
                </a>
            {% else %}
                <button type="button" class="btn btn-info ms-2 disabled" 
                        data-bs-toggle="tooltip" 
                        data-bs-placement="top" 
                        title="Seul le propriétaire peut partager cet inventaire">
                    <i class="bi bi-share me-2"></i>Partager
                </button>
            {% endif %}
            
            {% if can_edit is defined and can_edit %}
                <a href="{{ path('app_inventory_edit', {'id': inventory.id}) }}" class="btn btn-secondary ms-2">
                    <i class="bi bi-gear me-2"></i>Gérer l'inventaire
                </a>
            {% else %}
                <button type="button" class="btn btn-secondary ms-2 disabled" 
                        data-bs-toggle="tooltip" 
                        data-bs-placement="top" 
                        title="Vous n'avez pas les droits nécessaires pour modifier cet inventaire">
                    <i class="bi bi-gear me-2"></i>Gérer l'inventaire
                </button>
            {% endif %}
        </div>
    </div>

    {% if inventory.description %}
        <div class="alert alert-light mb-4">
            {{ inventory.description }}
        </div>
    {% endif %}

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Statistiques</h5>
                    <p>Nombre total d'articles: {{ inventory.items|length }}</p>
                </div>
            </div>
        </div>
        
        {% if inventory.sharedInventories|length > 0 %}
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Partagé avec</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Utilisateur</th>
                                <th>Niveau d'accès</th>
                                <th>Partagé le</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for shared in inventory.sharedInventories %}
                                <tr>
                                    <td>{{ shared.sharedWith.firstName }} {{ shared.sharedWith.lastName }}</td>
                                    <td>
                                        {% if shared.accessLevel == 'view' %}
                                            <span class="badge bg-info">Lecture uniquement</span>
                                        {% elseif shared.accessLevel == 'edit' %}
                                            <span class="badge bg-warning">Lecture et modification</span>
                                        {% elseif shared.accessLevel == 'admin' %}
                                            <span class="badge bg-danger">Tous les droits</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ shared.sharedAt|date('d/m/Y') }}</td>
                                    <td>
                                        <div class="d-flex">
                                            {% if is_owner is defined and is_owner %}
                                                <a href="{{ path('app_shared_inventory_edit', {'id': shared.id}) }}" class="btn btn-sm btn-primary me-1" title="Modifier les droits d'accès">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-danger" 
                                                       data-bs-toggle="modal" 
                                                       data-bs-target="#deleteShareModal" 
                                                       data-share-id="{{ shared.id }}"
                                                       data-share-user="{{ shared.sharedWith.firstName }} {{ shared.sharedWith.lastName }}">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            {% else %}
                                                <span class="text-muted">Actions non autorisées</span>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {% endif %}
    </div>

    <h2 class="mb-3">Articles</h2>

    {% if inventory.items|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Catégorie</th>
                        <th>Emplacement</th>
                        <th>Quantité</th>
                        <th>Date d'expiration</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in inventory.items %}
                        <tr>
                            <td>
                                {{ item.name }}
                            </td>
                            <td>{{ item.category ? item.category.name : 'N/A' }}</td>
                            <td>{{ item.location ? item.location.name : 'N/A' }}</td>
                            <td>{{ item.quantity ?: 1 }}</td>
                            <td>
                                {% if item.expiryDate %}
                                    {% set daysLeft = ((item.expiryDate|date('U') - "now"|date('U')) / 86400)|round %}
                                    {% if daysLeft < 0 %}
                                        <span class="badge bg-danger">Expiré depuis {{ daysLeft|abs }} jour(s)</span>
                                    {% elseif daysLeft <= 7 %}
                                        <span class="badge bg-warning text-dark">Expire dans {{ daysLeft }} jour(s)</span>
                                    {% else %}
                                        {{ item.expiryDate|date('d/m/Y') }}
                                    {% endif %}
                                {% else %}
                                    N/A
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_item_show', {'id': item.id}) }}" class="btn btn-sm btn-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                                
                                {% if can_edit is defined and can_edit %}
                                    <a href="{{ path('app_item_edit', {'id': item.id}) }}" class="btn btn-sm btn-secondary ms-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                {% else %}
                                    <button type="button" class="btn btn-sm btn-secondary ms-1 disabled" 
                                            data-bs-toggle="tooltip" 
                                            data-bs-placement="top" 
                                            title="Vous n'avez pas les droits nécessaires pour modifier cet article">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                {% endif %}
                                
                                {% if can_delete is defined and can_delete %}
                                    <button type="button" class="btn btn-sm btn-danger ms-1" 
                                           data-bs-toggle="modal" 
                                           data-bs-target="#deleteItemModal" 
                                           data-item-id="{{ item.id }}"
                                           data-item-name="{{ item.name }}">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                {% else %}
                                    <button type="button" class="btn btn-sm btn-danger ms-1 disabled" 
                                            data-bs-toggle="tooltip" 
                                            data-bs-placement="top" 
                                            title="Vous n'avez pas les droits nécessaires pour supprimer cet article">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info">
            <p class="mb-0">Cet inventaire est vide. <a href="{{ path('app_item_new', {'inventory_id': inventory.id}) }}">Ajoutez un article</a> pour commencer à l'utiliser.</p>
        </div>
    {% endif %}

    <!-- Modal de confirmation de suppression de partage -->
    <div class="modal fade" id="deleteShareModal" tabindex="-1" aria-labelledby="deleteShareModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteShareModalLabel">Confirmer la suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir supprimer le partage avec <strong id="shareUserName"></strong> ?</p>
                    <p class="text-danger">Cette action est irréversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form id="deleteShareForm" method="post" action="">
                        <input type="hidden" name="_token" id="shareToken" value="">
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de confirmation de suppression d'article -->
    <div class="modal fade" id="deleteItemModal" tabindex="-1" aria-labelledby="deleteItemModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteItemModalLabel">Confirmer la suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir supprimer l'article <strong id="itemName"></strong> ?</p>
                    <p class="text-danger">Cette action est irréversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form id="deleteItemForm" method="post" action="">
                        <input type="hidden" name="_token" id="itemToken" value="">
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Gestion du modal de suppression de partage
            const deleteShareModal = document.getElementById('deleteShareModal');
            if (deleteShareModal) {
                deleteShareModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const shareId = button.getAttribute('data-share-id');
                    const shareUser = button.getAttribute('data-share-user');
                    
                    // Mise à jour des informations du modal
                    document.getElementById('shareUserName').textContent = shareUser;
                    
                    // Mise à jour du formulaire de suppression
                    const form = document.getElementById('deleteShareForm');
                    form.action = "{{ path('app_shared_inventory_remove', {'id': 'SHARE_ID'}) }}".replace('SHARE_ID', shareId);
                    document.getElementById('shareToken').value = "{{ csrf_token('delete') }}".slice(0, -1) + shareId;
                });
            }
            
            // Gestion du modal de suppression d'article
            const deleteItemModal = document.getElementById('deleteItemModal');
            if (deleteItemModal) {
                deleteItemModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const itemId = button.getAttribute('data-item-id');
                    const itemName = button.getAttribute('data-item-name');
                    
                    // Mise à jour des informations du modal
                    document.getElementById('itemName').textContent = itemName;
                    
                    // Mise à jour du formulaire de suppression
                    const form = document.getElementById('deleteItemForm');
                    form.action = "{{ path('app_item_delete', {'id': 'ITEM_ID'}) }}".replace('ITEM_ID', itemId);
                    document.getElementById('itemToken').value = "{{ csrf_token('delete') }}".slice(0, -1) + itemId;
                });
            }
        });
    </script>
{% endblock %}