{% extends 'base.html.twig' %}

{% block title %}Mon profil - 1ventaire{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">1ventaire</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_inventory_index') }}">Mes inventaires</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_item_expiring_soon') }}">Articles expirant bientôt</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                        Paramètres
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('app_category_index') }}">Catégories</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_location_index') }}">Emplacements</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle active" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                        {{ app.user.firstName }}
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item active" href="{{ path('app_user_profile') }}">Mon profil</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_user_change_password') }}">Changer mot de passe</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
    
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h2 class="mb-0">Mon profil</h2>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>Informations personnelles</h5>
                            <p><strong>Nom:</strong> {{ user.lastName }}</p>
                            <p><strong>Prénom:</strong> {{ user.firstName }}</p>
                            <p><strong>Email:</strong> {{ user.email }}</p>
                        </div>
                        <div class="col-md-6">
                            <h5>Statistiques</h5>
                            <p><strong>Nombre d'inventaires:</strong> {{ user.inventories|length }}</p>
                            <p><strong>Catégories:</strong> {{ user.categories|length }}</p>
                            <p><strong>Emplacements:</strong> {{ user.locations|length }}</p>
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_user_change_password') }}" class="btn btn-primary">Changer mon mot de passe</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}