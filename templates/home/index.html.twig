{% extends 'base.html.twig' %}

{% block title %}1ventaire - Gérez vos biens domestiques{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .hero-section {
            padding: 5rem 0;
            background-color: #f8f9fa;
        }
        .feature-card {
            margin-bottom: 2rem;
            padding: 1.5rem;
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            height: 100%;
        }
        .feature-icon {
            font-size: 2rem;
            margin-bottom: 1rem;
            color: #0d6efd;
        }
    </style>
{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">1ventaire</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_inventory_index') }}">Mes inventaires</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                            {{ app.user.firstName }}
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('app_user_profile') }}">Mon profil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Fonctionnalités</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#how-it-works">Comment ça marche</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary" href="{{ path('app_login') }}">Connexion</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1>Organisez et partagez vos inventaires simplement</h1>
                <p class="lead">1ventaire est votre solution complète pour gérer tous vos inventaires, suivre les dates de péremption et partager vos collections avec vos proches.</p>
                <div class="mt-4">
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg me-2">Créer un compte gratuit</a>
                    <a href="#features" class="btn btn-outline-secondary btn-lg">Découvrir les fonctionnalités</a>
                </div>
            </div>
            {# <div class="col-lg-6">
                <img src="{{ asset('uploads/home-inventory-dashboard.jpg') }}" alt="1ventaire Dashboard" class="img-fluid rounded shadow">
            </div> #}
        </div>
    </div>
</section>

<section class="py-5" id="features">
    <div class="container">
        <h2 class="text-center mb-5">Nos fonctionnalités principales</h2>
        <div class="row">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">�</div>
                    <h3>Gestion d'inventaires</h3>
                    <p>Créez et gérez plusieurs inventaires pour différents besoins (cuisine, garage, collection, etc.) avec une organisation efficace.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🔔</div>
                    <h3>Alertes de péremption</h3>
                    <p>Suivez les dates de péremption de vos produits et recevez des alertes pour les articles qui expirent bientôt.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">�</div>
                    <h3>Partage d'inventaires</h3>
                    <p>Partagez vos inventaires avec votre famille ou vos amis pour une gestion collaborative.</p>
                </div>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">📍</div>
                    <h3>Gestion des emplacements</h3>
                    <p>Organisez vos articles par emplacements (armoire, tiroir, étagère) pour savoir exactement où ils se trouvent.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🏷️</div>
                    <h3>Catégorisation</h3>
                    <p>Classifiez vos objets par catégories personnalisables pour une recherche et une gestion facilitées.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">📱</div>
                    <h3>Interface réactive</h3>
                    <p>Accédez à votre inventaire depuis n'importe quel appareil grâce à notre interface responsive.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light" id="how-it-works">
    <div class="container">
        <h2 class="text-center mb-5">Comment ça marche</h2>
        <div class="row">
            <div class="col-md-3 text-center">
                <div class="mb-3">1️⃣</div>
                <h4>Créez un compte</h4>
                <p>Inscrivez-vous gratuitement en quelques secondes</p>
            </div>
            <div class="col-md-3 text-center">
                <div class="mb-3">2️⃣</div>
                <h4>Créez un inventaire</h4>
                <p>Définissez un nom et une description pour votre nouvel inventaire</p>
            </div>
            <div class="col-md-3 text-center">
                <div class="mb-3">3️⃣</div>
                <h4>Ajoutez des objets</h4>
                <p>Enregistrez vos articles avec leurs caractéristiques et dates d'expiration</p>
            </div>
            <div class="col-md-3 text-center">
                <div class="mb-3">4️⃣</div>
                <h4>Partagez et gérez</h4>
                <p>Partagez votre inventaire et suivez efficacement vos articles</p>
            </div>
        </div>
    </div>
</section>

<section class="py-5" id="contact">
    <div class="container">
        <h2 class="text-center mb-5">Démarrez dès aujourd'hui</h2>
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <div class="card border-0 shadow-lg">
                    <div class="card-body p-5">
                        <h3 class="mb-4">Prêt à mieux gérer vos inventaires ?</h3>
                        <p class="lead mb-4">Rejoignez des milliers d'utilisateurs qui ont simplifié la gestion de leurs biens grâce à 1ventaire.</p>
                        <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg px-5">S'inscrire gratuitement</a>
                        <p class="mt-3">Déjà inscrit ? <a href="{{ path('app_login') }}">Connectez-vous</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="bg-dark text-light py-4">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <h5>1ventaire</h5>
                <p>Votre solution complète de gestion d'inventaires</p>
                <p>Pour toute question : <a href="mailto:support@1ventaire.com" class="text-light">support@1ventaire.com</a></p>
            </div>
            <div class="col-md-6 text-md-end">
                <p class="mb-2">© 2025 1ventaire. Tous droits réservés.</p>
                <p class="small">Développé avec Symfony 7.2</p>
            </div>
        </div>
    </div>
</footer>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}