{% extends 'base.html.twig' %}

{% block title %}1ventaire - Tableau de bord{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .dashboard-header {
            background-color: #f8f9fa;
            padding: 2rem 0;
            margin-bottom: 2rem;
        }
        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            margin-bottom: 1.5rem;
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
        .section-header {
            margin-bottom: 1.5rem;
            border-bottom: 1px solid #dee2e6;
            padding-bottom: 0.75rem;
        }
        .inventory-card {
            height: 100%;
        }
        .expiry-warning {
            color: #dc3545;
            font-weight: bold;
        }
        .expiry-soon {
            color: #fd7e14;
            font-weight: bold;
        }
        .days-left {
            font-size: 0.9rem;
            display: block;
        }
        .table-danger td {
            background-color: rgba(220, 53, 69, 0.15);
        }
        .expired-label {
            background-color: #dc3545;
            color: white;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 0.8rem;
            margin-left: 5px;
        }
        .expired-items-section {
            background-color: rgba(220, 53, 69, 0.05);
            border-radius: 8px;
            padding: 1.5rem;
            border-left: 5px solid #dc3545;
        }
        .expired-items-section .section-header {
            border-bottom-color: rgba(220, 53, 69, 0.3);
        }
        .shared-inventory-card {
            border-left: 4px solid #6f42c1;
        }
    </style>
{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">1ventaire</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_inventory_index') }}">Mes inventaires</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_category_index') }}">Catégories</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_location_index') }}">Emplacements</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                        {{ app.user.firstName }}
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('app_user_profile') }}">Mon profil</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="dashboard-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="mb-2">Bonjour, {{ app.user.firstName }} !</h1>
                <p class="lead text-muted">Bienvenue sur votre tableau de bord 1ventaire.</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a href="{{ path('app_inventory_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Nouvel inventaire
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container mt-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}
    
    <!-- Recent Inventories Section -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center section-header">
            <h2>Vos inventaires récents</h2>
            <a href="{{ path('app_inventory_index') }}" class="text-decoration-none">Voir tous</a>
        </div>
        
        <div class="row">
            {% if recentInventories is empty %}
                <div class="col-12">
                    <div class="alert alert-info">
                        <p class="mb-0">Vous n'avez pas encore d'inventaire. <a href="{{ path('app_inventory_new') }}">Créez-en un</a> pour commencer à organiser vos biens.</p>
                    </div>
                </div>
            {% else %}
                {% for inventory in recentInventories %}
                    <div class="col-md-4">
                        <div class="card inventory-card">
                            <div class="card-body">
                                <h5 class="card-title">{{ inventory.name }}</h5>
                                <p class="card-text text-muted">
                                    {{ inventory.description|default('Aucune description')|length > 100 ? inventory.description|slice(0, 100) ~ '...' : inventory.description|default('Aucune description') }}
                                </p>
                                <div class="d-flex align-items-center">
                                    <span class="me-3"><i class="bi bi-box me-1"></i> {{ inventory.items|length }} articles</span>
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <a href="{{ path('app_inventory_show', {'id': inventory.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>Voir
                                </a>
                                <a href="{{ path('app_item_new', {'inventory_id': inventory.id}) }}" class="btn btn-sm btn-outline-success ms-1">
                                    <i class="bi bi-plus-circle me-1"></i>Ajouter un article
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </section>
    
    <!-- Shared Inventories Section -->
    {% if sharedInventories is defined and sharedInventories is not empty %}
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center section-header">
            <h2>Inventaires partagés avec vous</h2>
        </div>
        
        <div class="row">
            {% for inventory in sharedInventories %}
                <div class="col-md-4">
                    <div class="card inventory-card shared-inventory-card">
                        <div class="card-body">
                            <h5 class="card-title">
                                {{ inventory.name }}
                                <span class="badge bg-purple float-end">Partagé</span>
                            </h5>
                            <p class="card-text text-muted">
                                {{ inventory.description|default('Aucune description')|length > 100 ? inventory.description|slice(0, 100) ~ '...' : inventory.description|default('Aucune description') }}
                            </p>
                            <p class="card-text"><small class="text-muted">Par: {{ inventory.owner.firstName }} {{ inventory.owner.lastName }}</small></p>
                            <div class="d-flex align-items-center">
                                <span class="me-3"><i class="bi bi-box me-1"></i> {{ inventory.items|length }} articles</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white">
                            <a href="{{ path('app_inventory_show', {'id': inventory.id}) }}" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Voir
                            </a>
                            
                            {% set sharedAccess = null %}
                            {% for shared in inventory.sharedInventories %}
                                {% if shared.sharedWith.id == app.user.id %}
                                    {% set sharedAccess = shared %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if sharedAccess and sharedAccess.accessLevel in ['edit', 'admin'] %}
                                <a href="{{ path('app_item_new', {'inventory_id': inventory.id}) }}" class="btn btn-sm btn-outline-success ms-1">
                                    <i class="bi bi-plus-circle me-1"></i>Ajouter un article
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}
    
    <!-- Expiring Items Section -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center section-header">
            <h2>Articles expirant prochainement</h2>
        </div>
        
        <div class="row">
            {% if expiringItems is empty %}
                <div class="col-12">
                    <div class="alert alert-info">
                        <p class="mb-0">Aucun article n'expire prochainement.</p>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Inventaire</th>
                                    <th>Catégorie</th>
                                    <th>Emplacement</th>
                                    <th>Date d'expiration</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in expiringItems %}
                                    {% set daysUntilExpiry = date(item.expiryDate).diff(date()).days %}
                                    <tr>
                                        <td>{{ item.name }}</td>
                                        <td>{{ item.inventory.name }}</td>
                                        <td>
                                            {% if item.category %}
                                                <span class="d-inline-flex align-items-center">
                                                    <span style="display: inline-block; width: 12px; height: 12px; background-color: {{ item.category.color }}; margin-right: 6px; border-radius: 2px;"></span>
                                                    {{ item.category.name }}
                                                </span>
                                            {% else %}
                                                -
                                            {% endif %}
                                        </td>
                                        <td>{{ item.location ? item.location.name : '-' }}</td>
                                        <td>
                                            {% if daysUntilExpiry < 7 %}
                                                <span class="expiry-warning">
                                                    {{ item.expiryDate|date('d/m/Y') }}
                                                    <span class="days-left">{{ daysUntilExpiry }} jour{% if daysUntilExpiry > 1 %}s{% endif %} restant{% if daysUntilExpiry > 1 %}s{% endif %}</span>
                                                </span>
                                            {% else %}
                                                <span class="expiry-soon">
                                                    {{ item.expiryDate|date('d/m/Y') }}
                                                    <span class="days-left">{{ daysUntilExpiry }} jours restants</span>
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a href="{{ path('app_item_edit', {'id': item.id}) }}" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
    
    <!-- Expired Items Section -->
    <section class="mb-5 expired-items-section">
        <div class="section-header d-flex justify-content-between align-items-center">
            <h2><i class="bi bi-exclamation-triangle text-danger me-2"></i>Articles expirés</h2>
            {% if expiredItems is not empty %}
                <form method="post" id="delete-all-expired-form" action="{{ path('app_item_delete_expired') }}" style="display: inline-block;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_expired') }}">
                    <button type="button" class="btn btn-danger" data-delete-form="delete-all-expired-form" data-delete-message="Êtes-vous sûr de vouloir supprimer tous les articles expirés ? Cette action est irréversible.">
                        <i class="bi bi-trash me-1"></i>Supprimer tous les articles expirés
                    </button>
                </form>
            {% endif %}
        </div>
        
        <div class="row">
            {% if expiredItems is empty %}
                <div class="col-12">
                    <div class="alert alert-success">
                        <p class="mb-0">Aucun article n'a expiré. Bravo pour votre bonne gestion!</p>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Inventaire</th>
                                    <th>Catégorie</th>
                                    <th>Emplacement</th>
                                    <th>Date d'expiration</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in expiredItems %}
                                    {% set daysSinceExpiry = date().diff(date(item.expiryDate)).days %}
                                    <tr class="table-danger">
                                        <td>{{ item.name }}</td>
                                        <td>{{ item.inventory.name }}</td>
                                        <td>
                                            {% if item.category %}
                                                <span class="d-inline-flex align-items-center">
                                                    <span style="display: inline-block; width: 12px; height: 12px; background-color: {{ item.category.color }}; margin-right: 6px; border-radius: 2px;"></span>
                                                    {{ item.category.name }}
                                                </span>
                                            {% else %}
                                                -
                                            {% endif %}
                                        </td>
                                        <td>{{ item.location ? item.location.name : '-' }}</td>
                                        <td>
                                            <span class="text-danger fw-bold">
                                                {{ item.expiryDate|date('d/m/Y') }}
                                                <span class="days-left">Expiré depuis {{ daysSinceExpiry }} jour{% if daysSinceExpiry > 1 %}s{% endif %}</span>
                                            </span>
                                        </td>
                                        <td>
                                            <a href="{{ path('app_item_edit', {'id': item.id}) }}" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" id="delete-form-item-expired-{{ item.id }}" action="{{ path('app_item_delete', {'id': item.id}) }}" style="display: inline-block;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-delete-form="delete-form-item-expired-{{ item.id }}" data-delete-message="Êtes-vous sûr de vouloir supprimer cet article expiré ?">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
    
    <!-- Quick Links Section -->
    <section class="mb-5">
        <div class="section-header">
            <h2>Actions rapides</h2>
        </div>
        
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="bi bi-plus-circle display-4 text-primary mb-3"></i>
                        <h5 class="card-title">Nouvel inventaire</h5>
                        <p class="card-text">Créez un nouvel inventaire pour organiser vos biens.</p>
                        <a href="{{ path('app_inventory_new') }}" class="btn btn-primary">Créer</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="bi bi-tags display-4 text-success mb-3"></i>
                        <h5 class="card-title">Gérer les catégories</h5>
                        <p class="card-text">Organisez vos articles avec des catégories.</p>
                        <a href="{{ path('app_category_index') }}" class="btn btn-success">Gérer</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="bi bi-geo-alt display-4 text-info mb-3"></i>
                        <h5 class="card-title">Gérer les emplacements</h5>
                        <p class="card-text">Suivez où sont stockés vos articles.</p>
                        <a href="{{ path('app_location_index') }}" class="btn btn-info">Gérer</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
            
            // Delete confirmation logic
            var deleteButtons = document.querySelectorAll('[data-delete-form]');
            deleteButtons.forEach(function(button) {
                button.addEventListener('click', function() {
                    var formId = this.getAttribute('data-delete-form');
                    var message = this.getAttribute('data-delete-message');
                    
                    if (confirm(message)) {
                        document.getElementById(formId).submit();
                    }
                });
            });
        });
    </script>
{% endblock %}
